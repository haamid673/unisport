# Copy to .env.local (git-ignored via *.local) and fill in. Restart `npm run dev` after editing.
#
# Local stack: run `supabase start`, then `supabase status` and copy the
# API URL and the PUBLISHABLE key.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable key from `supabase status`>

# SECURITY: every VITE_* variable is embedded in the JavaScript shipped
# to browsers. Only the publishable (anon) key belongs here. NEVER put a
# secret key (sb_secret_...) or the service_role key in any VITE_* variable.
# The app refuses to start if it recognises one.

# Optional: deploy under a sub-path (for example /unisport/). Defaults to /.
# VITE_BASE_PATH=/

# Optional: online payment in Razorpay TEST mode. The PUBLIC test key id
# only (rzp_test_...); it must be the same key the payments-create-order
# Edge Function is configured with (RAZORPAY_KEY_ID in its server-only
# env file). Live keys (rzp_live_...) are refused. The Razorpay key
# SECRET and webhook secret NEVER go here: they are Edge Function
# secrets. Leave unset to keep online payment switched off.
# VITE_RAZORPAY_TEST_KEY_ID=rzp_test_xxxxxxxxxxxxxx
