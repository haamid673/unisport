# Copy to .env.local (git-ignored via *.local) and fill in. Restart `npm run dev` after editing.
#
# Local stack: run `supabase start`, then `supabase status` and copy the
# API URL and the PUBLISHABLE key.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable key from `supabase status`>

# SECURITY: every VITE_* variable is embedded in the JavaScript shipped
# to browsers. Only the publishable (anon) key belongs here. NEVER put a
# secret key (sb_secret_...) or the service_role key in any VITE_* variable.
# The app refuses to start if it recognises one.
